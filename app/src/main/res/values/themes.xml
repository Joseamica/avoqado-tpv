<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
    Avoqado TPV Theme - Base XML theme

    This is the STARTUP theme only (splash screen, before Compose loads).
    Once Compose loads, AvoqadoTheme() in Theme.kt takes over completely.

    Default: Light mode (matching Compose default).
    System bars are transparent - Compose handles icon colors dynamically.
    -->
    <style name="Theme.Avoqadotpv" parent="Theme.Material3.Light.NoActionBar">
        <!-- ========== Background & Surface (Light) ========== -->
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#111827</item>

        <!-- ========== Primary Brand Color ========== -->
        <item name="colorPrimary">@color/avoqado_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- ========== Status Bar (Transparent - Compose handles) ========== -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- ========== Navigation Bar (Transparent - Compose handles) ========== -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- ========== Window Background (White for light default) ========== -->
        <item name="android:windowBackground">@color/light_background</item>
    </style>
</resources>
