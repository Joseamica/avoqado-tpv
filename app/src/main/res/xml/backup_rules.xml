<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
    <!-- C2: el id de instalación y el contador de capturas son de ESTA terminal; restaurados en otra harían que el servidor descarte capturas buenas como viejas. -->
    <exclude domain="sharedpref" path="proof_capture.xml"/>
    <!-- D6 (Codex r2): la base local (colas de Mesas y de pagos, caja, libreta) es de ESTA terminal y de ESTE momento. Una copia
         vieja restaurada traería operaciones que el servidor ya rechazó por número y que la cola renumeraría, ejecutándolas
         después de otras más nuevas. Al reinstalar, la base empieza vacía, como en una terminal nueva. -->
    <exclude domain="database" path="avoqado_database"/>
    <exclude domain="database" path="avoqado_database-wal"/>
    <exclude domain="database" path="avoqado_database-shm"/>
</full-backup-content>