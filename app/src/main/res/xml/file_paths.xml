<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        FileProvider paths for APK installation (self-update feature)
        Downloads directory where APK updates are stored
    -->
    <external-path
        name="downloads"
        path="Download/" />

    <!-- Alternative: external files directory for Android 10+ scoped storage -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Cache directory fallback -->
    <cache-path
        name="cache"
        path="." />
</paths>
