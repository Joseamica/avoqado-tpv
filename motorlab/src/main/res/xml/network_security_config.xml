<?xml version="1.0" encoding="utf-8"?>
<!-- Motor de cobro · laboratorio: texto claro SÓLO hacia el respondedor local de la propia app (127.0.0.1, L-d). Todo lo
     demás (Blumon) va por TLS con los certificados del sistema. Su efecto se prueba en L-d, por conducta. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
